// Prisma schema for PKS.art PostgreSQL database

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String         @id @default(uuid())
  name          String
  email         String         @unique
  phone         String // Nomor WhatsApp (Wajib)
  password      String? // Password hashed / plain for admin security
  address       String // Alamat Lengkap (Wajib)
  avatar        String?
  region        String // e.g. "Jawa Barat", "DIY", "Sumut"
  role          String?        @default("Kreator") // e.g. "DPW PKS", "Kreator"
  status        String?        @default("Pending") // e.g. "Pending", "Active", "Suspended"
  isVerified    Boolean        @default(false)
  artworks      Artwork[]
  likes         Like[]
  comments      Comment[]
  createdAt     DateTime       @default(now())
  notifications Notification[]
  twibbonFrames TwibbonFrame[]
  twibbonFavorites TwibbonFavorite[]
  twibbonUsages UserTwibbonUsage[]
}

model Artwork {
  id             String    @id @default(uuid())
  title          String
  slug           String?   @unique
  description    String?
  imageUrl       String
  imageUrls      String[]  @default([])
  downloadUrl    String?
  category       String // e.g. "Poster", "Spanduk", "Social Media", "Infografis", "Templat"
  region         String // e.g. "DPW Jabar", "DKI", "DIY", "Sumut", "Nasional"
  format         String?   @default("Hanya gambar")
  tags           String[]  @default([])
  likesCount     Int       @default(0)
  commentsCount  Int       @default(0)
  downloadsCount Int       @default(0)
  stampsCount    Int       @default(0)
  authorId       String
  author         User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  likes          Like[]
  comments       Comment[]
  isFeatured     Boolean   @default(false)
  status         String    @default("Disetujui")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Like {
  id        String   @id @default(uuid())
  userId    String
  artworkId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  artwork   Artwork  @relation(fields: [artworkId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, artworkId])
}

model Comment {
  id        String   @id @default(uuid())
  content   String
  userId    String
  artworkId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  artwork   Artwork  @relation(fields: [artworkId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  isEdited  Boolean  @default(false)
}

model CustomPage {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String
  content     String // JSON string storing block structure
  published   Boolean  @default(true)
  useRootPath Boolean  @default(false)
  ogImageUrl  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Notification {
  id          String   @id @default(uuid())
  type        String
  title       String
  description String
  isRead      Boolean  @default(false)
  iconColor   String?
  bgColor     String?
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
}

model TwibbonFrame {
  id         String   @id @default(uuid())
  title      String
  slug       String?  @unique
  description String?
  imageUrl   String
  imageUrls  String[] @default([])
  category   String   @default("Nasional")
  region     String   @default("Nasional")
  usedCount  Int      @default(0)
  status     String   @default("Pending")
  isFeatured Boolean  @default(false)
  authorId   String
  author     User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  favorites  TwibbonFavorite[]
  usages     UserTwibbonUsage[]
  createdAt  DateTime @default(now())
}

model UserTwibbonUsage {
  id            String       @id @default(uuid())
  userId        String?
  user          User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  twibbonId     String
  twibbon       TwibbonFrame @relation(fields: [twibbonId], references: [id], onDelete: Cascade)
  resultImageUrl String?
  ipAddress     String?
  createdAt     DateTime     @default(now())
}

model DpwOffice {
  id             String   @id @default(uuid())
  name           String
  code           String   @unique
  coordinator    String
  phone          String
  email          String
  address        String
  lat            Float?
  lng            Float?
  activeCreators Int      @default(0)
  totalArtworks  Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model ArtworkReport {
  id              String   @id @default(uuid())
  artworkId       String
  artworkTitle    String
  artworkImageUrl String
  reason          String
  status          String   @default("Pending") // "Pending", "Resolved", "Rejected"
  createdAt       DateTime @default(now())
}

model BrandKit {
  id             String   @id @default(uuid())
  title          String
  slug           String?  @unique
  description    String?
  category       String
  format         String
  iconType       String
  color          String
  fileUrl        String
  previewUrl     String?
  isPublic       Boolean  @default(true)
  downloadsCount Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt @default(now())
}

model SiteSettings {
  id              String   @id @default("settings")
  siteName        String
  siteDescription String
  logoUrl         String
  logoAdminUrl    String
  logoFooterUrl   String
  faviconUrl      String
  ogImageUrl      String?  // Social Share Preview Thumbnail (1200x630)
  // CTA Banner settings
  ctaTitle        String?
  ctaDescription  String?
  ctaButtonText   String?
  ctaButtonLink   String?
  ctaLogoUrl      String?
  ctaImageUrl     String?
  ctaBgUrl        String?
  ctaEnabled      Boolean  @default(true)
  ctaSocialText   String?
  ctaSocialUrl    String?
  ctaLinks        String?  // Store serialized JSON array of links
  ctaSocialLinks  String?  // Store serialized JSON array of multi social media links
  adminWhatsapp   String?  @default("6281199887766")
  maintenanceConfig String? // JSON string storing maintenance mode toggles and custom message
  autoApproveArtworks Boolean @default(true) // Whether uploaded artworks are automatically approved or require moderation
  allowCommentLinks   Boolean @default(true) // Whether links/urls are allowed in user comments
  forbiddenWords  String?  // Comma-separated list or newline-separated list of prohibited words for auto moderation
  onlyAdminCanCreateTwibbon Boolean @default(false) // Batasi pembuatan template twibbon hanya untuk Super Admin
  updatedAt       DateTime @updatedAt
}

model PageView {
  id          String   @id @default(uuid())
  path        String   // e.g. "/", "/explore", "/twibbon"
  referrer    String?  // e.g. "https://instagram.com", "https://google.com"
  source      String   @default("Direct") // "Direct", "Google", "Instagram", "WhatsApp", "Facebook", "TikTok", "Twitter / X", "Lainnya"
  ip          String?
  country     String   @default("Indonesia")
  countryCode String   @default("ID")
  region      String   @default("DKI Jakarta") // Provinsi
  city        String   @default("Jakarta")     // Kota/Kabupaten
  device      String   @default("Mobile")      // "Mobile", "Desktop", "Tablet"
  browser     String   @default("Chrome")      // "Chrome", "Safari", "Edge", "Firefox", etc.
  os          String   @default("Android")     // "Android", "iOS", "Windows", "macOS"
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([path])
  @@index([source])
  @@index([region])
}

model TwibbonFavorite {
  id        String   @id @default(uuid())
  userId    String
  twibbonId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  twibbon   TwibbonFrame @relation(fields: [twibbonId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, twibbonId])
}

model ResetRequest {
  id        String    @id @default(uuid())
  name      String
  email     String
  phone     String
  token     String?   @unique
  expiresAt DateTime?
  used      Boolean   @default(false)
  status    String    @default("Pending") // "Pending", "Selesai", "Expired"
  createdAt DateTime  @default(now())
}


